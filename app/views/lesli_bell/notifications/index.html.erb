<%= render(LesliView::Layout::Container.new("lesli-bell-notifications-index")) do %>

    <%= render(LesliView::Components::Header.new(
        "Notifications",
        "Review important updates and mark them as read when you are done."
    )) do %>
    <span class="inline-flex w-fit items-center gap-2 rounded-full bg-sky-50 px-3 py-1.5 text-sm font-medium text-sky-700 ring-1 ring-inset ring-sky-200">
                    <span class="material-symbols text-lg leading-none" aria-hidden="true">notifications</span>
                    <%= pluralize(@notifications.dig(:pagination, :total) || @notifications[:records].size, "unread notification") %>
                </span>
        <%= render(LesliView::Elements::Button.new(
            "Mark all as read",
            url: mark_all_as_read_notifications_path,
            icon: "done_all",
            method: :put,
            disabled: @notifications[:records].empty?,
            data: { turbo_submits_with: "Marking all as read..." }
        )) %>
    <% end %>

    <% if @notifications[:records].empty? %>
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
            <%= render(LesliView::Elements::Empty.new(
                text: "You're all caught up",
                description: "New unread notifications will appear here."
            )) %>
        </div>
    <% else %>
        <section aria-label="Unread notifications">
            <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
                <ol class="divide-y divide-slate-200">
                    <% @notifications[:records].each do |notification| %>
                        <%
                            category_label, category_icon, accent_classes, icon_classes, badge_classes = case notification[:category].to_s
                            when "danger"
                                [
                                    "Attention",
                                    "error",
                                    "bg-danger-500",
                                    "bg-danger-50 text-danger-700",
                                    "bg-danger-50 text-danger-700 ring-danger-200"
                                ]
                            when "warning"
                                [
                                    "Warning",
                                    "warning",
                                    "bg-warning-500",
                                    "bg-warning-50 text-warning-700",
                                    "bg-warning-50 text-warning-700 ring-warning-200"
                                ]
                            when "success"
                                [
                                    nil,
                                    "check_circle",
                                    "bg-success-500",
                                    "bg-success-50 text-success-700",
                                    nil
                                ]
                            when "info"
                                [
                                    nil,
                                    "info",
                                    "bg-info-500",
                                    "bg-info-50 text-info-700",
                                    nil
                                ]
                            else
                                [
                                    nil,
                                    "notifications",
                                    "bg-neutral-400",
                                    "bg-neutral-50 text-neutral-700",
                                    nil
                                ]
                            end
                        %>

                        <li>
                            <article class="group relative bg-white px-4 py-3.5 pr-14 transition-colors hover:bg-slate-50 sm:px-5 sm:py-4 sm:pr-16">
                                <span class="absolute inset-y-0 left-0 w-1 <%= accent_classes %>" aria-hidden="true"></span>

                                <%= button_to(
                                    notification_path(notification[:id]),
                                    method: :put,
                                    class: "inline-flex size-8 shrink-0 items-center justify-center rounded-full border border-transparent bg-slate-100 text-slate-500 transition-colors hover:bg-sky-100 hover:text-sky-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-500/30 focus-visible:ring-offset-2",
                                    form: { class: "absolute right-4 top-3.5 inline-flex sm:right-5 sm:top-4" },
                                    data: { turbo_submits_with: "…" },
                                    title: "Mark as read",
                                    aria: { label: "Mark #{notification[:subject]} as read" }
                                ) do %>
                                    <span class="material-symbols text-lg leading-none" aria-hidden="true">done</span>
                                <% end %>

                                <div class="flex items-start gap-3">
                                    <div class="flex size-9 shrink-0 items-center justify-center rounded-lg <%= icon_classes %>">
                                        <span class="material-symbols text-xl leading-none" aria-hidden="true"><%= category_icon %></span>
                                    </div>

                                    <div class="min-w-0 flex-1">
                                        <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                                            <h4 class="text-sm font-semibold leading-5 text-slate-800 sm:text-base">
                                                <% if notification[:url].present? %>
                                                    <a
                                                        class="inline-flex items-center gap-1 rounded-md transition-colors hover:text-sky-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-500/30 focus-visible:ring-offset-2"
                                                        href="<%= notification[:url] %>"
                                                        target="_blank"
                                                        rel="noopener noreferrer">
                                                        <%= notification[:subject] %>
                                                        <span class="material-symbols text-base leading-none text-slate-400" aria-hidden="true">open_in_new</span>
                                                    </a>
                                                <% else %>
                                                    <%= notification[:subject] %>
                                                <% end %>
                                            </h4>

                                            <% if category_label.present? %>
                                                <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold ring-1 ring-inset <%= badge_classes %>">
                                                    <%= category_label %>
                                                </span>
                                            <% end %>
                                        </div>

                                        <% if notification[:body].present? %>
                                            <p class="mt-1 text-sm leading-5 text-slate-600 <%= "line-clamp-2" if notification[:url].present? %>">
                                                <%= notification[:body] %>
                                            </p>
                                        <% end %>

                                        <% if notification[:created_at].present? %>
                                            <time
                                                class="mt-1.5 block text-xs text-slate-400"
                                                datetime="<%= notification[:created_at].iso8601 %>">
                                                <%= time_ago_in_words(notification[:created_at]) %> ago
                                            </time>
                                        <% end %>
                                    </div>
                                </div>
                            </article>
                        </li>
                    <% end %>
                </ol>
            </div>
        </section>
    <% end %>
<% end %>
