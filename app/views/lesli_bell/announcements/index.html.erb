<%= render LesliView::Layout::Container.new("announcements-index") do %>
    <%= render LesliView::Components::Header.new(t("lesli_bell.announcements.title")) do %>
        <%= render LesliView::Elements::Button.new(t("lesli_bell.announcements.new"), url: new_announcement_path, icon: "add") %>
    <% end %>
    <%= render LesliView::Elements::Table.new(
        columns: %w[name category publication start_at end_at].map { |field| { field: field, label: t("lesli_bell.announcements.#{field}") } },
        records: @announcements.map { |announcement| {
            id: announcement.id, name: announcement.name,
            category: t("lesli_bell.announcements.categories.#{announcement.category}"),
            publication: t("lesli_bell.announcements.#{announcement.active? ? 'active' : 'inactive'}"),
            start_at: announcement_datetime(announcement.start_at),
            end_at: announcement_datetime(announcement.end_at)
        } },
        link: ->(announcement) { announcement_path(announcement.fetch(:id)) },
        empty: t("lesli_bell.announcements.empty")
    ) %>
    <nav class="mt-6 flex gap-3" aria-label="<%= t('lesli_bell.announcements.pagination') %>">
        <% if @announcements.prev_page %>
            <%= render LesliView::Elements::Button.new(t("lesli_bell.announcements.previous"), url: announcements_path(page: @announcements.prev_page, perPage: @announcements.limit_value), solid: false) %>
        <% end %>
        <% if @announcements.next_page %>
            <%= render LesliView::Elements::Button.new(t("lesli_bell.announcements.next"), url: announcements_path(page: @announcements.next_page, perPage: @announcements.limit_value), solid: false) %>
        <% end %>
    </nav>
<% end %>
